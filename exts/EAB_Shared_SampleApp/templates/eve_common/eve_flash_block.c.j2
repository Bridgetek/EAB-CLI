// Asset information (Get from Global symbols)
extern eve_flash_asset_info_t eve_asset_info[];
extern int number_of_assets;

// Information about the flash block image which will be loaded from PC side
static eve_flash_block_t flash_blocks =
{
    .size = {{ fileCfg.fileSize }},
    .name = "{{ fileCfg.fileName }}",
    .pData = NULL
};

/**********************************************************************************************************************/
/* Functions declarations                                                                                             */
/**********************************************************************************************************************/

int load_flash_blocks_to_ram_g(void)
{
    // Start address in RAM_G
    uint32_t start_addr = EVE_RAM_G;

    // Load data from image file
    if (!EVE_LIB_LoadAssetFromFile((eve_asset_info_t *)&flash_blocks))
    {
        printf("Error loading FlashImage data\n");
        return -1;
    }
    printf("FlashImage data loaded successfully...\n");

    // Write data to RAM_G
    EVE_LIB_WriteDataToRAMG(flash_blocks.pData, flash_blocks.size, start_addr);
    printf("FlashImage data written to RAM_G successfully.\n");

    // Clean up the image data pointer. Avoid the memory leak.
    if (flash_blocks.pData)
    {
        free(flash_blocks.pData);
        flash_blocks.pData = NULL;
    }

    return 0;
}

void show_log_asset(const EVE_Flash_Asset_Info *asset, const char *assetName, bool isLoaded)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return;
    }

    if (isLoaded)
    {
        printf("***** Asset Loaded Successfully: *****\n");
    }
    else
    {
        printf("***** Asset Load Failed: *****\n");
    }
    printf("***** Asset Information: *****\n");
    printf("Asset Name:    %s\n", assetName);
    printf("Asset ID:      %d\n", asset->assetID);
    printf("Start Address: 0x%08X\n", asset->startAddress);
    printf("Size:          %u\n", asset->size);
    printf("Compression:   %u\n", asset->compression);
    printf("Type:          %u\n", asset->type);
    printf("SubType:       %u\n", asset->subType);
    printf("Width:         %u\n", asset->width);
    printf("Height:        %u\n", asset->height);
    printf("***** -------- End ----- *****\n");
}

void cleanup_ramg_block(void)
{
    // Clean up the RAM_G data
    EVE_LIB_BeginCoProList();
    EVE_CMD_MEMZERO(EVE_RAM_G, (flash_blocks.size + 0xFFF) & ~0xFFF); // Align to 4K
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();
}

void cleanup_monitor(void)
{
    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);
    EVE_DISPLAY();
    EVE_CMD_SWAP();
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();
}

bool eve_flash_is_asset_type_valid(const EVE_Flash_Asset_Info *asset)
{
    if (asset == NULL)
    {
        return false;
    }

    // Check if the asset type is valid
    if (asset->type == FLASH_ASSET_TYPE_NONE ||
        asset->type == FLASH_ASSET_TYPE_FLASH_DRIVER ||
        asset->type == FLASH_ASSET_TYPE_EDF_BLOCK)
    {
        return false;
    }

    // Check if the size is valid
    if (asset->size == 0 || asset->startAddress + asset->size > EVE_RAM_G_SIZE)
    {
        return false;
    }

    return true;
}

void eve_load_flash_block(void)
{
    // Read data from PC side and load it to RAM_G
    int result = load_flash_blocks_to_ram_g();
    if (result != 0)
    {
        printf("Failed to load flash blocks to RAM_G...\n");
        return;
    }

    printf("Switching to full mode...\n");
    EVE_LIB_flash_switchFullMode();

    printf("Erasing flash...\n");
    EVE_LIB_flash_erase();
    printf("Flash erased successfully.\n");

    printf("Programming flash blocks...\n");
    uint32_t alignSize = (flash_blocks.size + 0xFFF) & ~0xFFF; // Align to 4K
    eve_flash_err_t flashErr = EVE_FLASH_ERR_SUCCESS;
    uint32_t destFlashAddr = 0; // Flash address to write the data
    EVE_LIB_flash_program(destFlashAddr, EVE_RAM_G, alignSize);
    printf("Flash blocks programmed successfully.\n");

    printf("Cleaning up RAM_G...\n");
    cleanup_ramg_block();

    // From this point, we can use the flash blocks in the EVE application.
    printf("Flash blocks are ready to use in the EVE application.\n");
    uint32_t newAddr = EVE_RAM_G;
    eve_flash_err_t res = EVE_LIB_LoadAssetFromFlash(newAddr, 0, alignSize);
    if (res != EVE_FLASH_ERR_SUCCESS)
    {
        printf("Failed to load asset from flash: %d\n", res);
        return;
    }

// Debugging: Save the flash blocks data to a file for debugging
// If unlock the definition above will save the flash blocks data to a file
// for debugging purpose. The file will be named "flash_blocks_debug.bin"
// #define SAVE_FLASH_BLOCKS_DEBUG
#ifdef SAVE_FLASH_BLOCKS_DEBUG
    flash_blocks.pData = (uint8_t *)malloc(alignSize);
    if (flash_blocks.pData == NULL)
    {
        printf("Error allocating memory for flash blocks data\n");
        return;
    }
    memset(flash_blocks.pData, 0, alignSize);

    // Read RAM_G to store the data for debugging
    for (uint32_t i = 0; i < alignSize; i += 4)
    {
        EVE_LIB_RegRead(EVE_RAM_G + i, (uint32_t *)&flash_blocks.pData[i]);
    }

    // Write the flash blocks data to a file for debugging
    FILE *debug_file = fopen("flash_blocks_debug.bin", "wb");
    if (debug_file) {
        size_t written = fwrite(flash_blocks.pData, 1, alignSize, debug_file);
        fclose(debug_file);
        printf("Flash blocks data written to debug file: %zu bytes\n", written);
    } else {
        printf("Failed to create debug file\n");
    }
#endif // SAVE_FLASH_BLOCKS_DEBUG

    // Loop all the assets in the flash list
    for (size_t i = 0; i < number_of_assets; i++)
    {
        // Get the asset info
        EVE_Flash_Asset_Info *asset = eve_asset_info[i].info;
        const char *assetName = eve_asset_info[i].name;
        const uint32_t padding = eve_asset_info[i].padding;

        // Check if the asset is valid
        if (eve_flash_is_asset_type_valid(asset) == false)
        {
            printf("Invalid asset type for asset: %s\n", assetName);
            continue;
        }

        show_log_asset(asset, assetName, (flashErr == EVE_FLASH_ERR_SUCCESS));
        // Data is loaded to RAM_G, now we can show the asset
        uint32_t flashAssetStartAddr = newAddr + asset->startAddress;
        eve_flash_helper_load_asset(asset, flashAssetStartAddr);

        Sleep(4000); // Wait for 4 seconds to show the asset
    }

    // Cleanup the monitor
    cleanup_monitor();
}
