/**
 @file eve_videos.c
 */

#include <stdint.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#include "EVE.h"
#include "eve_example.h"

typedef eve_asset_info_t eve_video_t;

eve_video_t video_info = {
    .fileSize = {{ fileCfg.fileSize }},
    .filename = "{{ fileCfg.fileName }}",
    .pData    = NULL
};

void eve_load_video(void)
{
    uint32_t videoAddr = EVE_RAM_G;

    if (!EVE_LIB_LoadAssetFromFile(&video_info))
    {
        printf("Error loading video data\n");
        return;
    }
    printf("Video data loaded successfully...\n");


    EVE_LIB_lvds_config(EVE_FORMAT_YCBCR, LVDS_MODE_DIRECTVIDEO);

    HAL_MemWrite32(EVE_REG_VOL_L_PB, 155);
    HAL_MemWrite32(EVE_REG_VOL_R_PB, 155);
    HAL_MemWrite32(EVE_REG_PLAY_CONTROL, 1);

    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);

    EVE_CMD_PLAYVIDEO(OPT_DIRECT | OPT_SOUND | OPT_YCBCR);

    /* The video size must be the same as the screen resolution */
    printf("Start to load Video to RAM CMD...\n");
    EVE_LIB_WriteDataToCMD(video_info.pData, video_info.fileSize);
    EVE_LIB_AwaitCoProEmpty();
    printf("Video data loaded successfully to board...\n");

    EVE_LIB_lvds_config(EVE_FORMAT_YCBCR, LVDS_MODE_VIDEO);

    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    if (video_info.pData)
    {
        free(video_info.pData);
        video_info.pData = NULL;
    }
}
