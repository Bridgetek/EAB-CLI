{
  "id": "image_converter",
  "date_install": "2026-10-15_08:00:00:001",
  "category": "converter",
  "name": "Image Converter",
  "version": "0.1.0",
  "extension_type": "app",
  "engine": "native",
  "author": "EAB User",
  "description": "Convert images for EVE display chips \u2014 BT82x and Legacy groups. Tools: img_cvt, img_val (PNG/JPEG validator), jpeg_optimize (JPEG optimizer), raw_viewer (raw pixels to PNG)",
  "icon": "\ud83d\uddbc\ufe0f",
  "ui": "ui.html",
  "cli_commands": [
    "ft80x img_cvt",
    "ft81x img_cvt",
    "bt88x img_cvt",
    "bt81x img_cvt",
    "bt82x img_cvt",
    "validate",
    "img_val",
    "bt82x img_val",
    "ft80x img_val",
    "ft81x img_val",
    "bt88x img_val",
    "bt81x img_val",
    "jpeg_optimize",
    "ft80x jpeg_optimize",
    "ft81x jpeg_optimize",
    "bt88x jpeg_optimize",
    "bt81x jpeg_optimize",
    "raw_viewer",
    "bt82x raw_viewer",
    "ft80x raw_viewer",
    "ft81x raw_viewer",
    "bt88x raw_viewer",
    "bt81x raw_viewer"
  ],
  "permissions": [
    "gui.render",
    "gui.components",
    "fs.read",
    "fs.write",
    "process.spawn",
    "cli.legacy",
    "cli.bt82x",
    "cli.validate",
    "cli.img_val",
    "cli.bt82x img_val",
    "cli.legacy img_val",
    "cli.jpeg_optimize",
    "cli.legacy jpeg_optimize",
    "cli.raw_viewer",
    "cli.bt82x raw_viewer",
    "cli.legacy raw_viewer"
  ],
  "dependencies": {
    "astc": "^5.5"
  },
  "app_dlls": [
    "native/img_cvt.dll"
  ],
  "native_payloads": [
    "native/pngquant/pngquant.exe",
    "native/turbojpeg/turbojpeg.dll"
  ],
  "api_version": "2.0",
  "start_with_eab": "yes"
}
