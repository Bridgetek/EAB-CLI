/**
 @file eve_images_flash.c
 */

#include <stdint.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#include "EVE.h"
#include "eve_example.h"

// This is the image information for image file
typedef struct eve_image_t
{
    size_t fileSize;
    const char *filename;
    uint8_t *pData;
    uint16_t width;
    uint16_t height;
    uint16_t linestride;
    uint16_t format_type;
} eve_image_t;

// Image information (Generated from EAB)
eve_image_t image_info = {
    .width       = {{ fileCfg.width }},
    .height      = {{ fileCfg.height }},
    .linestride  = {{ fileCfg.linestride }},
    .fileSize    = {{ fileCfg.fileSize }},
    .filename    = "{{ fileCfg.filename }}",
    .format_type = {{ fileCfg.format_type }},
    .pData       = NULL
};

// Example flash address for image storage
// We should ignore the 1st 4K of flash memory (blob header)
static const uint32_t EVE_FLASH_IMAGE_ADDR = 0x1000;

void eve_load_image(void)
{
    // Start address in RAM_G
    uint32_t start_addr = EVE_RAM_G;

    // Load data from image file
    if (!EVE_LIB_LoadAssetFromFile((eve_asset_info_t *)&image_info))
    {
        printf("Error loading image data\n");
        return;
    }
    printf("Image data loaded successfully...\n");

    // Write data to RAM_G first
    printf("Writing image data to RAM_G at address 0x%08X...\n", start_addr);
    EVE_LIB_WriteDataToRAMG(image_info.pData, image_info.fileSize, start_addr);
    printf("Image data written to RAM_G successfully.\n");

    // Erase the flash memory before loading the image
    printf("Erasing flash memory...\n");
    EVE_LIB_flash_erase();
    printf("Flash memory erased successfully.\n");

    // Store the image in to flash memory
    printf("Storing image to flash memory at address 0x%08X...\n", EVE_FLASH_IMAGE_ADDR);
    if (EVE_FLASH_ERR_SUCCESS != EVE_LIB_flash_program(EVE_FLASH_IMAGE_ADDR, start_addr, image_info.fileSize))
    {
        printf("Error programming image to flash memory\n");
        return;
    }
    printf("Image stored successfully at address 0x%08X\n", EVE_FLASH_IMAGE_ADDR);

    // Switch to full mode for flash memory
    if (EVE_FLASH_ERR_SUCCESS != EVE_LIB_flash_switchFullMode())
    {
        printf("Error: Switching flash memory to full mode failed...\n");
        return;
    }
    printf("Flash memory switched to full mode successfully.\n");

    // Calculate the address to load the image from flash memory (aligned to 4K boundary)
    uint32_t addr_to_load_image_from_flash = (start_addr + image_info.fileSize + 0xFFF) & ~0xFFF;
    printf("Starting to load image form flash memory, at address: 0x%.08x to RAM_G at 0x%.08x...\n",
           EVE_FLASH_IMAGE_ADDR, addr_to_load_image_from_flash);
    if (EVE_FLASH_ERR_SUCCESS != EVE_LIB_LoadAssetFromFlash(addr_to_load_image_from_flash, EVE_FLASH_IMAGE_ADDR,
                                                            image_info.fileSize))
    {
        printf("Error loading image from flash memory\n");
        return;
    }
    printf("Image loaded from flash memory, now displaying...\n");

    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CMD_SETBITMAP(addr_to_load_image_from_flash, image_info.format_type, image_info.width, image_info.height);
{% if fileCfg.zorder %}
    EVE_BITMAP_ZORDER({{ fileCfg.zorder_value }});
{% if "ASTC" in fileCfg.format_type %}
    EVE_BITMAP_LAYOUT_H(({{ fileCfg.zorder_width }} * 16) >> 10, {{ fileCfg.zorder_height_blocks }} >> 9);
    EVE_BITMAP_LAYOUT(image_info.format_type, ({{ fileCfg.zorder_width }} * 16) & 0x3FF,
                      {{ fileCfg.zorder_height_blocks }});
{% endif %}
{% endif %}
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);
    EVE_BEGIN(EVE_BEGIN_BITMAPS);
    EVE_VERTEX2F(0, 0);
    EVE_END();
    EVE_DISPLAY();
    EVE_CMD_SWAP();
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    printf("Image loaded from flash memory and displayed successfully.\n");

    if (image_info.pData)
    {
        free(image_info.pData);
        image_info.pData = NULL;
    }
}
