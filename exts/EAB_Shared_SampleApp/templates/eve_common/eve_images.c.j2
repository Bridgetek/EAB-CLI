/**
 @file eve_images.c
 */

#include <stdint.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#include "EVE.h"
#include "eve_example.h"

#define eve_free(ptr) do { free(ptr); ptr = NULL;} while (0)

// This is the image information for image file
typedef struct eve_image_t
{
    size_t fileSize;
    const char *filename;
    uint8_t *pImgData;
    uint16_t width;
    uint16_t height;
    uint16_t linestride;
    uint16_t format_type;
} eve_image_t;

// Image information (Generated from EAB)
eve_image_t image_info = {
    .width       = {{ fileCfg.width }},
    .height      = {{ fileCfg.height }},
    .linestride  = {{ fileCfg.linestride }},
    .fileSize    = {{ fileCfg.fileSize[0] }},
    .filename    = "{{ fileCfg.filename[0] }}",
    .format_type = {{ fileCfg.format_type }},
    .pImgData    = NULL
};

{% if "PALETTEDARGB8" in fileCfg.format_type %}
eve_asset_info_t palette_info = {
    .fileSize = {{ fileCfg.fileSize[1] }},
    .filename = "{{ fileCfg.filename[1] }}",
    .pData = NULL
};
{% endif %}

void eve_load_image(void)
{
    // Start address in RAM_G
    uint32_t start_addr = EVE_RAM_G;

    // Load data from image file
    if (!EVE_LIB_LoadAssetFromFile((eve_asset_info_t *)&image_info))
    {
        printf("Error loading image data\n");
        return;
    }
    printf("Image data loaded successfully...\n");

    // Write data to RAM_G
    EVE_LIB_WriteDataToRAMG(image_info.pImgData, image_info.fileSize, start_addr);

{% if "PALETTEDARGB8" in fileCfg.format_type %}
    if (!EVE_LIB_LoadAssetFromFile((eve_asset_info_t *)&palette_info))
    {
        printf("Error loading palette data\n");
        eve_free(image_info.pImgData);
        return;
    }
    printf("Palette data loaded successfully...\n");
    uint32_t palette_addr = (start_addr + image_info.fileSize + 63) & ~63;
    EVE_LIB_WriteDataToRAMG(palette_info.pData, palette_info.fileSize, palette_addr);
{% endif %}

    // Start display list
    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR(1, 1, 1);
    EVE_CLEAR_COLOR_RGB(0, 0, 0);

    EVE_CMD_SETBITMAP(start_addr, image_info.format_type, image_info.width, image_info.height);
{% if fileCfg.zorder %}
    EVE_BITMAP_ZORDER({{ fileCfg.zorder_value }});
{% if "ASTC" in fileCfg.format_type %}
    EVE_BITMAP_LAYOUT_H(({{ fileCfg.zorder_width }} * 16) >> 10, {{ fileCfg.zorder_height_blocks }} >> 9);
    EVE_BITMAP_LAYOUT(image_info.format_type, ({{ fileCfg.zorder_width }} * 16) & 0x3FF,
                      {{ fileCfg.zorder_height_blocks }});
{% endif %}
{% endif %}
    EVE_BEGIN(EVE_BEGIN_BITMAPS);
{% if "PALETTEDARGB8" in fileCfg.format_type %}
    EVE_PALETTE_SOURCE(palette_addr);
{% endif %}
    EVE_VERTEX2F(0, 0);
    EVE_END();

    EVE_DISPLAY();
    EVE_CMD_SWAP();
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    eve_free(image_info.pImgData);
{% if "PALETTEDARGB8" in fileCfg.format_type %}
    eve_free(palette_info.pData);
{% endif %}
}
