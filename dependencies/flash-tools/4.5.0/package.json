{
  "name": "flash-tools",
  "version": "4.5.0",
  "license": "Bridgetek (reference bundle)",
  "source": "EVE Asset Builder 4.5.0 reference install",
  "description": "SPI flash programmers for BT82X (flash.exe) and pre-BT82X (flash_2x.exe), plus the NAND patch blob flash.exe loads at start-up.",
  "variants": {
    "windows-x64": {
