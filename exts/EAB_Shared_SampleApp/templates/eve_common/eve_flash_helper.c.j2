
#include "eve_flash_helper.h"

#include "EVE.h"
#include "HAL.h"

// User will specify the first character of the legacy font. Looking at the EAB configuration,
// it is 32 (space character by default).
#define LEGACY_FONT_FIRST_CHAR 32
#define EXTENDED_FONT_FIRST_CHAR 0
// Default audio playback frequency and codec. User can change these values
// according to their needs.
#define AUDIO_PLAYBACK_FREQ 44100           // Default audio playback frequency
#define AUDIO_CODEC S16S_SAMPLES            // Default audio codec for playback

/**
 ***************************************************************************************************
 * \brief Show an image from the flash asset information.
 *
 * \param [in] asset - Pointer to the flash asset information.
 * \param [in] ramg_addr - Pointer to the RAM address where the image will be displayed.
 *
 * \return return 0 on success, or a negative error code on failure.
 **************************************************************************************************/
int eve_flash_helper_show_image(const EVE_Flash_Asset_Info *asset, const uint32_t ramg_addr)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return -1;
    }

    // Check if the asset type is a bitmap
    if (asset->type != FLASH_ASSET_TYPE_BITMAP &&
        asset->type != FLASH_ASSET_TYPE_BITMAP_PALETTED_INDEX &&
        asset->type != FLASH_ASSET_TYPE_BITMAP_PALETTED_LUT)
    {
        printf("Asset type is not a bitmap\n");
        return -1;
    }

    uint16_t format = 0;
    if (asset->type == FLASH_ASSET_TYPE_BITMAP)
    {
        format = asset->subType; // Use the subtype as the format
    }

    // Show the image using EVE library
    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR(1, 1, 1);
    EVE_COLOR_RGB(255, 255, 255);
    EVE_CMD_SETBITMAP(ramg_addr, format, asset->width, asset->height);
    EVE_BEGIN(EVE_BEGIN_BITMAPS);
    EVE_VERTEX2F(0, 0);
    EVE_END();
    EVE_DISPLAY();
    EVE_CMD_SWAP();
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    return 0;
}

/**
 ***************************************************************************************************
 * \brief Helper function to load an animation from flash to RAM_G.
 *
 * \param [in] asset - Pointer to the flash asset information.
 * \param [in] ramg_addr - RAM address where the animation will be loaded.
 *
 * \return return 0 on success, or a negative error code on failure.
 **************************************************************************************************/
int eve_flash_helper_load_animation(const EVE_Flash_Asset_Info *asset, const uint32_t ramg_addr)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return -1;
    }

    // Check if the asset type is an animation
    if (asset->type != FLASH_ASSET_TYPE_ANIMATION_BT82X)
    {
        printf("Asset type is not an animation\n");
        return -1;
    }

    printf("Loading animation from flash to RAM_G at address 0x%08X\n", ramg_addr);
    uint32_t waitMask = -1;
    // uint32_t play_control = 1024 * 512;
    uint32_t play_control = -1;
    uint32_t animationChannel = 0;

    EVE_LIB_BeginCoProList();
    EVE_CMD_FLASHSOURCE(asset->startAddress);
    EVE_CMD_LOADASSET(EVE_RAM_G, EVE_OPT_FLASH);
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);

    EVE_CMD_MEMZERO(play_control, 1);
    EVE_CMD_ANIMSTART(animationChannel, EVE_RAM_G, EVE_ANIM_ONCE);

    EVE_CMD_ANIMXY(animationChannel, EVE_DISP_WIDTH / 2, EVE_DISP_HEIGHT / 2);
    EVE_CMD_RUNANIM(waitMask, play_control);
    EVE_CMD_MEMSET(play_control, 1, 1);

    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    return 0; // Return success
}

/**
 ***************************************************************************************************
 * \brief Helper function to load an audio asset from flash to RAM_G.
 *
 * \param [in] asset - Pointer to the flash asset information.
 * \param [in] ramg_addr - RAM address where the audio will be loaded.
 *
 * \return return 0 on success, or a negative error code on failure.
 **************************************************************************************************/
int eve_flash_helper_load_audio(const EVE_Flash_Asset_Info *asset, const uint32_t ramg_addr)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return -1;
    }

    // Check if the asset type is audio
    if (asset->type != FLASH_ASSET_TYPE_AUDIO_BT82X)
    {
        printf("Asset type is not audio\n");
        return -1;
    }

    printf("Loading audio from flash to RAM_G at address 0x%08X\n", ramg_addr);
    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);

    HAL_MemWrite32(EVE_REG_PLAYBACK_START, EVE_RAM_G);
    HAL_MemWrite32(EVE_REG_PLAYBACK_LENGTH, asset->size);
    HAL_MemWrite32(EVE_REG_PLAYBACK_FREQ, AUDIO_PLAYBACK_FREQ);
    HAL_MemWrite32(EVE_REG_PLAYBACK_FORMAT, AUDIO_CODEC);
    HAL_MemWrite32(EVE_REG_PLAYBACK_LOOP, 0);
    HAL_MemWrite32(EVE_REG_VOL_L_PB, 155);
    HAL_MemWrite32(EVE_REG_VOL_R_PB, 155);
    HAL_MemWrite32(EVE_REG_PLAYBACK_PLAY, 1);

    printf("Audio playback started...\n");
    uint32_t result = HAL_MemRead32(EVE_REG_PLAYBACK_PLAY);
    while (result != 0) {
        result = HAL_MemRead32(EVE_REG_PLAYBACK_PLAY);
    };
    printf("Audio playback finished...\n");

    HAL_MemWrite32(EVE_REG_PLAYBACK_LENGTH, 0);
    HAL_MemWrite32(EVE_REG_PLAYBACK_LOOP, 0);
    HAL_MemWrite32(EVE_REG_VOL_L_PB, 0);
    HAL_MemWrite32(EVE_REG_VOL_R_PB, 0);
    HAL_MemWrite32(EVE_REG_PLAYBACK_PLAY, 1);

    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    return 0; // Return success
}

/**
 ***************************************************************************************************
 * \brief Helper function to load a video asset from flash to RAM_G.
 *
 * \param [in] asset - Pointer to the flash asset information.
 * \param [in] ramg_addr - RAM address where the video will be loaded.
 *
 * \return return 0 on success, or a negative error code on failure.
 **************************************************************************************************/
int eve_flash_helper_load_video(const EVE_Flash_Asset_Info *asset, const uint32_t ramg_addr)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return -1;
    }

    // Check if the asset type is video
    if (asset->type != FLASH_ASSET_TYPE_VIDEO_BT82X)
    {
        printf("Asset type is not video\n");
        return -1;
    }

    printf("Loading video from flash to RAM_G at address 0x%08X\n", ramg_addr);
    EVE_LIB_lvds_config(EVE_FORMAT_YCBCR, LVDS_MODE_DIRECTVIDEO);

    HAL_MemWrite32(EVE_REG_VOL_L_PB, 155);
    HAL_MemWrite32(EVE_REG_VOL_R_PB, 155);
    HAL_MemWrite32(EVE_REG_PLAY_CONTROL, 1);

    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);

    EVE_CMD_FLASHSOURCE(asset->startAddress);
    EVE_CMD_PLAYVIDEO(OPT_DIRECT | OPT_SOUND | OPT_YCBCR | EVE_OPT_FLASH);

    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    return 0; // Return success
}

/**
 ***************************************************************************************************
 * \brief Helper function to load a font asset from flash to RAM_G.
 *
 * \param [in] asset - Pointer to the flash asset information.
 * \param [in] ramg_addr - RAM address where the font will be loaded.
 *
 * \return return 0 on success, or a negative error code on failure.
 **************************************************************************************************/
int eve_flash_helper_load_font(const EVE_Flash_Asset_Info *asset, const uint32_t ramg_addr)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return -1;
    }

    // Check if the asset type is a font
    if (asset->type != FLASH_ASSET_TYPE_FONT_LEGACY_BT82X &&
        asset->type != FLASH_ASSET_TYPE_FONT_EXTENDED1_BT82X &&
        asset->type != FLASH_ASSET_TYPE_FONT_EXTENDED2_BT82X)
    {
        printf("Asset type is not a font\n");
        return -1;
    }

    if (ramg_addr % 64 != 0)
    {
        printf("RAM_G address must be aligned to 64 bytes\n");
        return -1;
    }

    // Determine if the font is extended or legacy
    // Extended fonts have different first character than legacy fonts
    bool isExtendedFont = (asset->type == FLASH_ASSET_TYPE_FONT_EXTENDED1_BT82X ||
                           asset->type == FLASH_ASSET_TYPE_FONT_EXTENDED2_BT82X);
    uint32_t firstChar = isExtendedFont ? EXTENDED_FONT_FIRST_CHAR : LEGACY_FONT_FIRST_CHAR;

    printf("Loading font from flash to RAM_G at address 0x%08X\n", ramg_addr);

    // Extract the font from Flash to RAM_G to use it
    EVE_LIB_BeginCoProList();
    EVE_CMD_FLASHSOURCE(asset->startAddress);
    EVE_CMD_LOADASSET(ramg_addr, EVE_OPT_FLASH);
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    // Start display list
    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR(1, 1, 1);
    EVE_COLOR_RGB(255, 255, 255);

    EVE_CMD_SETFONT(FONT_CUSTOM_HANDLE, ramg_addr, firstChar);
    EVE_CMD_TEXT(0, 0, FONT_CUSTOM_HANDLE, 0, "Hello World, This is a test for EAB converted font");

    EVE_END();
    EVE_DISPLAY();
    EVE_CMD_SWAP();
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    return 0; // Return success
}

/**
 ***************************************************************************************************
 * \brief Helper function to load an asset on RAM_G which already loaded from flash.
 *
 * \param [in] asset - Pointer to the flash asset information.
 * \param [in] ramg_addr - RAM address where the asset will be loaded.
 *
 * \return return 0 on success, or a negative error code on failure.
 **************************************************************************************************/
int eve_flash_helper_load_asset(const EVE_Flash_Asset_Info *asset, const uint32_t ramg_addr)
{
    if (asset == NULL)
    {
        printf("Invalid asset information\n");
        return -1;
    }

    switch (asset->type)
    {
        case FLASH_ASSET_TYPE_BITMAP:
        case FLASH_ASSET_TYPE_BITMAP_PALETTED_INDEX:
        case FLASH_ASSET_TYPE_BITMAP_PALETTED_LUT:
            // Load bitmap asset from flash to RAM_G
            return eve_flash_helper_show_image(asset, ramg_addr);
        case FLASH_ASSET_TYPE_ANIMATION_BT82X:
            // Load animation asset from flash to RAM_G
            return eve_flash_helper_load_animation(asset, ramg_addr);
        case FLASH_ASSET_TYPE_AUDIO_BT82X:
            // Load audio asset from flash to RAM_G
            return eve_flash_helper_load_audio(asset, ramg_addr);
        case FLASH_ASSET_TYPE_VIDEO_BT82X:
            // Load video asset from flash to RAM_G
            return eve_flash_helper_load_video(asset, ramg_addr);
        case FLASH_ASSET_TYPE_FONT_LEGACY_BT82X:
        case FLASH_ASSET_TYPE_FONT_EXTENDED1_BT82X:
        case FLASH_ASSET_TYPE_FONT_EXTENDED2_BT82X:
            // Load font asset from flash to RAM_G
            return eve_flash_helper_load_font(asset, ramg_addr);
        case FLASH_ASSET_TYPE_FLASH_DRIVER:
            // Flash driver asset, typically not loaded to RAM_G
            printf("Flash driver asset does not need to be loaded to RAM_G\n");
            return 0;
        case FLASH_ASSET_TYPE_EDF_BLOCK:
            // EDF block asset, typically not loaded to RAM_G
            printf("EDF block asset does not need to be loaded to RAM_G\n");
            return 0;
        case FLASH_ASSET_TYPE_USER_DATA:
            // User data asset, typically not loaded to RAM_G
            printf("User data asset does not need to be loaded to RAM_G\n");
            return 0;
        case FLASH_ASSET_TYPE_PADDING_DATA:
            // Padding data asset, typically not loaded to RAM_G
            printf("Padding data asset does not need to be loaded to RAM_G\n");
            return 0;
        case FLASH_ASSET_TYPE_NONE:
            // No asset type, nothing to load
            printf("No asset type specified, nothing to load\n");
            return 0;
        default:
            printf("Unsupported asset type for loading: %d\n", asset->type);
            return -1;
    }

}
