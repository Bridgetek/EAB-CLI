{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                {% if fileCfg.platformName == "FT4222" %}
                "USE_FT4222=0",
                {% elif fileCfg.platformName == "MPSSE"%}
                "USE_MPSSE=0",
                {% else %}
                    {{ raise("Unsupported platform") }}
                {% endif %}
                "FTDIMPSSE_STATIC",
                "FT_VER_MAJOR=1",
                "FT_VER_MINOR=0",
                "FT_VER_BUILD=5",
                "WIN32",
                "_CONSOLE",
                "_LIB",
                "_UNICODE",
                "UNICODE"
            ],
            "windowsSdkVersion": "10.0.19041.0",
            "compilerPath": "cl.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}