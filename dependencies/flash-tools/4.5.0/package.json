        },
        {
          "src": "flash_2x.exe",
          "dst": "native/flash_2x.exe",
          "kind": "file"
        },
        {
          "src": "patch_nand.bin",
          "dst": "native/patch_nand.bin",
          "kind": "file"
        }
      ]
    }
  }
}
