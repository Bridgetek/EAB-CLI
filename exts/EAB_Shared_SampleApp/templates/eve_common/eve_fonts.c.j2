/**
 @file eve_fonts.c
 */

#include <stdint.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#include "EVE.h"
#include "eve_example.h"

typedef struct eve_asset_info_t eve_font_t;

eve_font_t font_info = {
    .fileSize = {{ fileCfg.fileSize }},
    .filename = "{{ fileCfg.fileName }}",
    .pData    = NULL
};

void eve_load_fonts(void)
{
    uint32_t fontAddr = EVE_RAM_G;

    // Load the font data
    if (!EVE_LIB_LoadAssetFromFile(&font_info))
    {
        printf("Error loading font data\n");
        return;
    }
    printf("Font data loaded successfully...\n");

    // Load the font into EVE memory
    EVE_LIB_BeginCoProList();
    EVE_CMD_LOADASSET(fontAddr, 0);
    EVE_LIB_WriteDataToCMD(font_info.pData, font_info.fileSize);
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    // Start display list
    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR(1, 1, 1);
    EVE_COLOR_RGB(255, 255, 255);

    EVE_CMD_SETFONT(FONT_CUSTOM_HANDLE, fontAddr, {{ fileCfg.firstChar}});
    EVE_CMD_TEXT(0, 0, FONT_CUSTOM_HANDLE, 0, "Hello World, This is a test for EAB converted font");

    EVE_END();
    EVE_DISPLAY();
    EVE_CMD_SWAP();
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    // Free the font data
    if (font_info.pData)
    {
        free(font_info.pData);
        font_info.pData = NULL;
    }
}
