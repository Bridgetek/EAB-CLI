/**
 @file eve_animation.c
 */

#include <stdint.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#include "EVE.h"
#include "eve_example.h"

typedef struct eve_animation_t
{
    size_t fileSize;
    const char *fileName;
    uint8_t *pData;
} eve_animation_t;

eve_animation_t animation_info = {
    .fileSize = {{ fileCfg.fileSize }},
    .fileName = "{{ fileCfg.fileName }}",
    .pData    = NULL
};

void eve_load_animation(void)
{
    uint32_t waitmask = -1;
    uint32_t play_control = 1024 * 512;
    uint32_t animationChannel = 0;

    if (!EVE_LIB_LoadAssetFromFile(&animation_info))
    {
        printf("Error loading animation data\n");
        return;
    }
    printf("Animation data loaded successfully...\n");

    EVE_LIB_BeginCoProList();
    EVE_CMD_LOADASSET(EVE_RAM_G, 0);
    EVE_LIB_WriteDataToCMD(animation_info.pData, animation_info.fileSize);
    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    EVE_LIB_BeginCoProList();
    EVE_CMD_DLSTART();
    EVE_CLEAR_COLOR_RGB(0, 0, 0);
    EVE_CLEAR(1, 1, 1);

    EVE_CMD_MEMZERO(play_control, 1);
    EVE_CMD_ANIMSTART(animationChannel, EVE_RAM_G, EVE_ANIM_LOOP);

    EVE_CMD_ANIMXY(animationChannel, EVE_DISP_WIDTH / 2, EVE_DISP_HEIGHT / 2);
    EVE_CMD_RUNANIM(waitmask, play_control);
    EVE_LIB_AwaitCoProEmpty();

    EVE_CMD_MEMSET(play_control, 1, 1);

    EVE_LIB_EndCoProList();
    EVE_LIB_AwaitCoProEmpty();

    if (animation_info.pData)
    {
        free(animation_info.pData);
        animation_info.pData = NULL;
    }
}
